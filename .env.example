# ============================================================
# 大模型配置（OpenAI 兼容 Chat Completions 协议）
# 这些环境变量会覆盖 data/config.json 中的对应配置。
# 优先级：环境变量 > 界面/配置文件
# ============================================================

# API Base URL（注意包含 /v1 前缀，视服务商而定）
LLM_BASE_URL=https://api.openai.com/v1
# API Key
LLM_API_KEY=sk-your-key-here
# 模型名称
LLM_MODEL=gpt-4o-mini
# 采样温度（0-2，越低越稳定）
LLM_TEMPERATURE=0.7

# ============================================================
# TTS 语音合成（可选，OpenAI audio/speech 协议）
# 不配置则视频渲染为纯画面 + 字幕，不合成配音
# ============================================================
TTS_ENABLED=false
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=sk-your-key-here
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ============================================================
# 服务配置
# ============================================================
# 服务监听端口（docker-compose 与 Dockerfile 默认 3000）
PORT=3000
