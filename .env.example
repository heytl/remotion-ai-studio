# ============================================================
# 大模型配置（OpenAI 兼容 Chat Completions 协议）
# 这些环境变量会覆盖 data/config.json 中的对应配置。
# 优先级：环境变量 > 界面/配置文件
# ============================================================

# API Base URL（注意包含 /v1 前缀，视服务商而定）
LLM_BASE_URL=https://api.openai.com/v1
# API Key
LLM_API_KEY=sk-your-key-here
# 模型名称
LLM_MODEL=gpt-4o-mini
# 采样温度（0-2，越低越稳定）
LLM_TEMPERATURE=0.7

# ============================================================
# TTS 语音合成（可选，OpenAI audio/speech 协议）
# 不配置则视频渲染为纯画面 + 字幕，不合成配音
# ============================================================
TTS_ENABLED=false
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=sk-your-key-here
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ============================================================
# 联网搜索（生成大纲/文稿前检索最新资料，可选）
# 不配置则生成时自动降级为纯大模型生成（离线知识）
# ============================================================
SEARCH_ENABLED=false
# 搜索服务商：tavily / serper / bocha（国内网络推荐 bocha 或 serper，tavily 可能被墙）
SEARCH_PROVIDER=tavily
# Tavily: https://tavily.com 获取；Serper: https://serper.dev 获取；Bocha 博查: https://open.bochaai.com 获取
SEARCH_API_KEY=
# 每个查询返回的结果数量（1-10，默认 5）
SEARCH_MAX_RESULTS=5

# ============================================================
# 服务配置
# ============================================================
# 服务监听端口（docker-compose 与 Dockerfile 默认 3000）
PORT=3000
